@using (Html.BeginForm("CreateNewCar", "car", FormMethod.Post))
{
    @Html.DisplayName("Num") <br />
    @Html.TextBox("Id", null, new { @class = "container-fluid; width:200px", placeholder = "Enter Num" })
   
    <br />

    @Html.DisplayName("Manfacture") <br />
    @Html.TextBox("Manfacture", null, new { @class = "container-fluid; width:200px", placeholder = "Enter Manfacture" })
   
    <br />

    @Html.DisplayName("Model")  <br />
    @Html.TextBox("Model", null, new { @class = "container-fluid; width:200px", placeholder = "Enter Model" })
    
    <br />
   
    @Html.DisplayName("Color")  <br />
    @Html.TextBox("Color", null, new { @class = "container-fluid; width:200px", placeholder = "Enter Color" })
   
    <br />
    <br />

    <input type="submit" class="btn btn-primary" value="Create" />
    @Html.ActionLink("Cancel", "GetAllCars", "car", null, new { @class = "btn btn-danger" })
}