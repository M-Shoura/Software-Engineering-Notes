@using (Html.BeginForm("UpdateCar", "car", FormMethod.Post))
{
    @Html.HiddenFor(x=>x.Num)

    @Html.DisplayNameFor(x=>x.Manfacture) <br />
    @Html.EditorFor(x=>x.Manfacture)

    <br />
    
    @Html.DisplayNameFor(x => x.Model) <br />
    @Html.EditorFor(x => x.Model)
    
    <br />

    @Html.DisplayNameFor(x => x.Color) <br />
    @Html.EditorFor(x => x.Color)
    
    <br />
    <br />
    
    <input type="submit" class="btn btn-primary" value="Save" />
    @Html.ActionLink("Cancel", "GetAllCars", "car", null, new { @class = "btn btn-danger" })
}