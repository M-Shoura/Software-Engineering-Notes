@model My.Models.City

@{
    ViewData["Title"] = "Edit";
    List<Country> ctrs = ViewBag.countries;
}

<h1>Edit</h1>

<h4>City</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @* <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CityID" />
            <div class="form-group">
                <label asp-for="CityName" class="control-label"></label>
                <input asp-for="CityName" class="form-control" />
                <span asp-validation-for="CityName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="cID" class="control-label"></label>
                <select asp-for="cID" class="form-control" asp-items="ViewBag.cID"></select>
                <span asp-validation-for="cID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form> *@

        @using(Html.BeginForm("Edit","city",FormMethod.Post))
        {
            @Html.HiddenFor(x=>Model.CityID)

            @Html.DisplayNameFor(x=>x.CityName) <br />
            @Html.EditorFor(x=>Model.CityName) <br />

            @Html.DisplayNameFor(x=>x.Cntry.CountryName) <br />
            <select name="cID" class="form-control">
                <option value="@Model.cID"> @Model.Cntry.CountryName </option>
                @for(int i=0 ; i<ctrs.Count ; i++)
                {
                    @if (Model.cID == ctrs[i].CountryID)
                        continue;
                    <option value="@ctrs[i].CountryID">@ctrs[i].CountryName</option>
                    
                    // Or another solution with "selected" attribute : 
                    //
                    // if(Model.cID == ctrs[i].CountryID)
                    //    <option value="@ctrs[i].CountryID" selected> @ctrs[i].CountryName </option>
                    // else 
                    //    <option value="@ctrs[i].CountryID"> @ctrs[i].CountryName </option>
                }
            </select>

            <input type="submit" value="Save" class="btn btn-primary" />
            @Html.ActionLink("Back To List", "Index", "City", null,new { @class = "btn btn-primary" })
        }
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
