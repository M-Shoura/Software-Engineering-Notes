
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />               @* To link the bootstrap *@
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" integrity="sha512-jnSuA4Ss2PkkikSOLtYs8BlYIeeIK1h99ty4YfvRPAlzr377vr3CXDb7sb7eEEBYjDtcYj+AjBH3FLv5uSJuXg==" crossorigin="anonymous" referrerpolicy="no-referrer" /> *@
</head>
<body>

    @* Start Header *@

    <header class="mt-5">
        <center>
            <nav>
                @{
                    // <a href="/Home/Index" class="btn btn-primary">Home</a>
                    // <a href="/Home/AboutUs" class="btn btn-warning">AboutUs</a>
                    // <a href="/Home/Privacy" class="btn btn-success">Privacy</a>
                    // <a href="/Home/ContactUs" class="btn btn-info">ContactUs</a>
                    //
                    // <a href="/Accounts/SignIn" class="btn btn-secondary">SignIn</a>
                    // <a href="/Accounts/SignUp" class="btn btn-danger">SignUp</a>
                    //
                    //
                    // @*1 - HTML Tag*@
                    // <a href="/Home/Index" class="btn btn-primary">Home</a>
                    //
                    // @*2 - HTML Helpers*@
                    // @*ActionLink : Returns a <a> element anchor tag element (but difficult syntax), we have 7 overloads for this function*@
                    // @*Note : we can make out own HTML Helper*@
                    // @Html.ActionLink("Home [HTML Helper]", "Index", "Home", null, new {@class="btn btn-primary"});
                    // @* @Html.BeginForm *@
                    // @* @Html.CheckBox *@
                    // @* @Html.TextBox *@
                    //
                    //
                    // @*3 - Tag Helpers*@
                    // @*easy as HTML code , introduced in .NET Core .. to use we must import for their namespace through :
                    //                                           "@addTagHelper * , Microsoft.AspNetCore.Mvc.TagHelpers" *@
                    // @*Note : we can make out own Tag Helper*@
                    // @* Tag helpers will be translated to HTML (inspect in the browser)*@
                    // <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Home</a>

                    // @*Note : if the action takes parameters -> asp-route-id="10"*@
                }
                

                @* Last After using Tag Helpers -------------------------------------------------------------------- *@

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Home</a>
                <a asp-controller="Home" asp-action="AboutUs" class="btn btn-warning">AboutUs</a>
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-success">Privacy</a>
                <a asp-controller="Home" asp-action="ContactUs" class="btn btn-info">ContactUs</a>
                <a asp-controller="Accounts" asp-action="SignIn" class="btn btn-secondary">SignIn</a>
                <a asp-controller="Accounts" asp-action="SignUp" class="btn btn-danger">SignUp</a>

            </nav>
        </center>
    </header>

    @* End Header *@

    @* Start Body *@

    <section>
        <center>
                @RenderBody()
        </center>
    </section>

    @* End Body *@


    @* Start Footer *@

    <footer>
        <center>
            <div class="mt-3">
                <p>CopyRights &copy; Shoura @DateTime.Now.Year</p>
            </div>
        </center>
    </footer>

    @* End Footer *@
</body>
</html>
