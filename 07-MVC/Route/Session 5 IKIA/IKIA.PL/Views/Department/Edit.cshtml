@*Specify the model that the view will interact with (submit/post the model) or (get the model)*@
@model DepartmentEditViewModel

@{
    ViewData["Title"] = "Edit";
}


@*Copy paste from the structure of the Create view (not recommended , we will discuss the partial view later to aviod this problem)*@

<div class="row justify-content-center align-items-center flex-column">
    <h1 class="col-6">Edit Department</h1>

    <br />
    <br />

    <form asp-action="Edit" class="col-6">
        @* default that -> method="post" *@
        @*asp-action="Edit" -> will be rendered in html to action="/Department/Edit/10"*@
        @*So from where the 10 comes ? it's from the Route : baseURL/Department/Edit/id*@
        <div asp-validation-summary="ModelOnly"></div>


        <div class="form-group mb-3">
            <label class="form-label" asp-for="Code"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"> </textarea>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="CreationDate"></label>
            <input type="date" asp-for="CreationDate" class="form-control" />
        </div>

        <div class="mt-4">
            <input type="submit" value="Save" class="btn btn-success" /> |
            <a asp-controller="Department" asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    </form>

</div>
