@model CreatedDepartmentDTO

@{
    ViewData["Title"] = "Create";
}



<div class="row justify-content-center align-items-center flex-column">
    <h1 class="col-6">Create New Department</h1>

    <br />
    <br />

    <form asp-action="Create" class="col-6">
        @*Important , when submiting the form ...*@

        @*For showing all the errors here , must be a div !! *@
        @* <div asp-validation-summary="All"></div> *@   @*will show all the errors including the shown in the spans in each of the next divs*@

        <div asp-validation-summary="ModelOnly"></div>   @*will show only the errors that we added in the controller with AddModelError*@


        <div class="form-group mb-3">
            <label class="form-label" asp-for="Code"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"> </textarea>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" asp-for="CreationDate"></label>
            <input type="date" asp-for="CreationDate" class="form-control" />
        </div>

        <div class="mt-4">
            <input type="submit" value="Create" class="btn btn-primary" /> |
            <a asp-controller="Department" asp-action="Index" class="btn btn-light">Back to List</a>
        </div>
    </form>

</div>
